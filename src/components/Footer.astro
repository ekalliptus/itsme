---
const year = new Date().getFullYear();
const sitemap = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/skills/', label: 'Skills' },
  { href: '/contact/', label: 'Contact' },
];
const socials = [
  { href: 'https://github.com/ekalliptus', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/ekalliptus/', label: 'LinkedIn' },
];
---
<footer class="footer container">
  <div class="footer-invite reveal">
    <div><p class="section-label">Have something in mind?</p><h2>Let's make<br><em>the pieces fit.</em></h2></div>
    <div class="invite-links"><a href="/contact/" class="contact-circle" aria-label="Discuss a project with Haikal"><svg class="link-arrow" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13.5M13.5 8L9 3.5M13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a><a href="mailto:salam@ekalliptus.com" class="footer-email">salam@ekalliptus.com</a></div>
  </div>
  <div class="footer-grid">
    <div class="footer-brand"><a href="/" class="footer-logo" aria-label="Haikal Akhalul Azhar Home">ekalliptus<span>.</span></a><p>Haikal Akhalul Azhar software engineer building web and mobile products and providing IT support.</p><span class="footer-location">Tegal, Jawa Tengah, Indonesia</span></div>
    <nav class="footer-col" aria-label="Sitemap"><span class="footer-col-head">Explore</span>{sitemap.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <nav class="footer-col" aria-label="Social links"><span class="footer-col-head">Elsewhere</span>{socials.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} profile (opens in a new tab)`}>{link.label} <svg class="link-arrow external" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>)}</nav>
    <div class="footer-col agency"><span class="footer-col-head">For your business</span><p>Need a website or mobile application?</p><a href="https://ekalliptus.com" target="_blank" rel="noopener noreferrer" aria-label="Visit Ekalliptus Digital (opens in a new tab)">Ekalliptus Digital <svg class="link-arrow external" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
  </div>
  <div class="footer-base"><p>&copy; {year} Haikal Akhalul Azhar</p><span class="footer-availability"><span aria-hidden="true"></span>Available for work</span></div>
</footer>
<style>
  .footer { margin-top: 100px; }
  .footer-invite { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 56px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  h2 { font-size: clamp(2.7rem, 6.5vw, 5.5rem); font-weight: 500; letter-spacing: -.055em; line-height: 1.1; }
  h2 em { font-family: Georgia, serif; color: var(--accent); font-weight: 400; }
  .invite-links { display: flex; flex-direction: column; align-items: end; gap: 12px; }
  .contact-circle { display: grid; place-items: center; width: 100px; height: 100px; background: var(--accent); color: var(--bg); border-radius: 50%; font-size: 3rem; transition: transform var(--transition), background var(--transition); }
  .contact-circle:hover { transform: rotate(-45deg); background: #b0e7db; }
  .footer-email { font-size: clamp(.9rem, 1.8vw, 1.3rem); border-bottom: 1px solid var(--line-strong); padding-bottom: 8px; }
  .footer-email:hover { color: var(--accent); }
  .footer-grid { display: grid; grid-template-columns: 1.8fr .7fr .7fr 1fr; gap: 42px; padding-block: 48px; }
  .footer-logo { display: inline-block; font: 600 1.8rem/1.4 var(--font-display); letter-spacing: -.06em; margin-bottom: 16px; }
  .footer-logo span { color: var(--accent); }
  .footer-brand p { max-width: 36ch; color: var(--text-sec); font-size: .82rem; }
  .footer-location { display: block; margin-top: 20px; font: .63rem/1.6 var(--font-mono); color: var(--text-mut); }
  .footer-col { display: flex; flex-direction: column; align-items: start; gap: 8px; }
  .footer-col-head { display: block; color: var(--text-mut); font: .62rem/1.5 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 12px; }
  .footer-col a { display: flex; align-items: center; gap: 12px; min-height: 32px; font-size: .85rem; }
  .footer-col a:hover { color: var(--accent); }
  .agency p { font-size: .82rem; color: var(--text-sec); max-width: 23ch; margin-bottom: 8px; }
  .agency a { color: var(--accent); }
  .footer-base { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-block: 24px 32px; border-top: 1px solid var(--line); font: .65rem/1.6 var(--font-mono); color: var(--text-mut); }
  .footer-availability { display: flex; align-items: center; gap: 8px; }
  .footer-availability > span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1.5fr 1fr 1fr; gap: 12px; } .agency { grid-column: 1/-1; } }
  @media (max-width: 600px) { .footer { margin-top: 64px; } .footer-invite { padding-block: 36px; align-items: start; flex-direction: column; gap: 30px; } .invite-links { width: 100%; align-items: center; flex-direction: row-reverse; justify-content: space-between; } .contact-circle { width: 60px; height: 60px; font-size: 2rem; } .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; } .footer-brand { grid-column: 1/-1; } .footer-base { align-items: start; flex-direction: column; gap: 10px; } }
</style>
