---
import LazyImage from './LazyImage.astro';

interface Props {
  icon: string;
  name: string;
  description: string;
  tags: string[];
  liveUrl: string;
  previewImage?: string | null;
}

const { name, description, tags, liveUrl, previewImage } = Astro.props;
---
<article class="project-card reveal">
  <a href={liveUrl} class="proj-preview-link" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
    {previewImage
      ? <LazyImage src={previewImage} alt={`${name} preview`} width={800} height={500} class="proj-screenshot" loading="lazy" />
      : <div class="proj-placeholder"><span>{name}</span><small>Website preview unavailable</small></div>
    }
  </a>
  <div class="proj-content">
    <header class="proj-header">
      <h3 class="proj-name">{name}</h3>
      <span class="proj-arrow" aria-hidden="true">↗</span>
    </header>
    <p class="proj-desc">{description}</p>
    <ul class="proj-tags" role="list" aria-label={`${name} technologies`}>
      {tags.map(tag => <li>{tag}</li>)}
    </ul>
    <footer class="proj-footer">
      <a
        href={liveUrl}
        class="proj-visit"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visit ${name} website (opens in a new tab)`}
      >
        Visit website <svg class="link-arrow external" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <span class="proj-domain">{new URL(liveUrl).hostname}</span>
    </footer>
  </div>
</article>

<style>
.project-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 24px;
}

.proj-preview-link {
  display: block;
  overflow: hidden;
  margin: 12px 12px 0;
  border-radius: 15px;
  background: var(--bg-soft);
}

.proj-preview-link :global(.lazy-img) {
  transition: transform 500ms var(--ease);
}

.proj-preview-link:hover :global(.lazy-img) { transform: scale(1.025); }

.proj-placeholder {
  aspect-ratio: 8 / 5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12px;
  padding: 32px;
  color: var(--accent);
  font-size: 1.75rem;
}

.proj-placeholder small { color: var(--text-sec); font: 0.75rem var(--font-mono); }

.proj-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 28px;
}

.proj-header { display: flex; align-items: start; justify-content: space-between; gap: 16px; }
.proj-name { font-size: clamp(1.2rem, 2vw, 1.5rem); font-weight: 600; line-height: 1.25; letter-spacing: -0.04em; }
.proj-arrow { color: var(--accent); font-size: 1.5rem; line-height: 1; }
.proj-desc { margin-top: 16px; color: var(--text-sec); font-size: 0.8125rem; line-height: 1.8; }

.proj-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 16px;
  list-style: none;
  padding: 20px 0 24px;
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
}

.proj-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}

.proj-visit { display: inline-flex; align-items: center; gap: 10px; font-size: 0.8125rem; font-weight: 600; }
.proj-visit:hover { color: var(--accent); }
.proj-domain { color: var(--text-sec); font: 0.625rem var(--font-mono); overflow-wrap: anywhere; }

@media (max-width: 600px) {
  .proj-content { padding: 22px; }
}

@media (prefers-reduced-motion: reduce) {
  .proj-preview-link :global(.lazy-img) { transition: none; transform: none; }
}
</style>
