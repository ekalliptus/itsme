---
// src/components/SkillsSphere.astro
import { SKILLS_DATA } from '../data/skills.js';
---
<div id="skills-sphere-container" class="skills-sphere-container" aria-label="Interactive 3D skills visualization">
  <!-- Shimmer loader while the WebGL scene + textures boot -->
  <div id="sphere-loader" class="sphere-loader" aria-hidden="true" hidden>
    <span class="skeleton sphere-skeleton"></span>
    <span class="sphere-loader-label">Loading stack…</span>
  </div>
  <canvas id="skills-sphere-canvas" aria-hidden="true"></canvas>

  <noscript>
    <p class="sphere-noscript">The interactive visualization requires JavaScript. The complete text list remains available below.</p>
  </noscript>
</div>

<ul class="skills-list" role="list" aria-label="Technical skills">
  {SKILLS_DATA.map(skill => (
    <li class="skill-item card">
      <img
        src={skill.icon}
        alt=""
        width="36"
        height="36"
        loading="lazy"
      />
      <span class="skill-name">{skill.name}</span>
    </li>
  ))}
</ul>

<style>
.skills-sphere-container {
  position: relative;
  width: 100%;
  height: 70vh;
  min-height: 400px;
  content-visibility: auto;
  contain-intrinsic-size: 70vh;
}

#skills-sphere-canvas {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 700ms var(--ease);
}
.skills-sphere-container.is-ready #skills-sphere-canvas { opacity: 1; }

/* Shimmer loader */
.sphere-loader {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  z-index: 2;
  transition: opacity 500ms var(--ease);
}
.skills-sphere-container.is-ready .sphere-loader {
  opacity: 0;
  pointer-events: none;
}
.sphere-skeleton {
  width: min(260px, 60vw);
  height: min(260px, 60vw);
  border-radius: 50%;
}
.sphere-loader-label {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text-mut);
}

.skills-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
  list-style: none;
  margin: 32px 0 0;
  padding: 0;
}

.skill-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
}

.skill-name {
  font-size: 12px;
  color: var(--text-sec);
  font-weight: 500;
}
</style>

<script>
  // Load the decorative scene only when its container nears the viewport.
  type Sphere = { dispose: () => void } | null;

  let sphere: Sphere = null;
  let booting = false;
  let observer: IntersectionObserver | null = null;

  function teardown() {
    observer?.disconnect();
    observer = null;
    if (sphere) {
      sphere.dispose();
      sphere = null;
    }
    booting = false;
  }

  document.addEventListener('astro:before-swap', teardown);

  async function boot() {
    const container = document.getElementById('skills-sphere-container');
    if (!container || sphere || booting) return;
    booting = true;

    const loader = document.getElementById('sphere-loader');
    if (loader) loader.hidden = false;

    try {
      const { initSkillsSphere } = await import('../scripts/skills-sphere.js');
      // A navigation may have torn things down while the chunk was in flight.
      if (!document.getElementById('skills-sphere-container')) return;
      sphere = initSkillsSphere('skills-sphere-container', 'dark');
    } catch {
      // Chunk or WebGL init failed → fall back to the static grid.
      document.getElementById('skills-sphere-canvas')?.remove();
      document.getElementById('sphere-loader')?.remove();
      return;
    } finally {
      booting = false;
    }

    // Reveal once textures have had a moment to load; rAF keeps it smooth.
    requestAnimationFrame(() => {
      setTimeout(() => container.classList.add('is-ready'), 220);
    });
  }

  function init() {
    const container = document.getElementById('skills-sphere-container');
    if (!container) return;

    // No WebGL → skip the 3D entirely, show the grid fallback.
    const probe = document.createElement('canvas');
    const gl = probe.getContext('webgl') || probe.getContext('experimental-webgl');
    if (!gl) {
      document.getElementById('skills-sphere-canvas')?.remove();
      document.getElementById('sphere-loader')?.remove();
      return;
    }

    // Boot the 3D scene when near viewport via IntersectionObserver
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          observer?.disconnect();
          observer = null;
          boot();
        }
      }, { rootMargin: '250px' });
      observer.observe(container);
    } else {
      boot();
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
