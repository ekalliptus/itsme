---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects.js';

const projectCount = PROJECTS.length;

const pillars = [
  {
    no: '01',
    label: 'PROFILE',
    href: '/about/',
    title: 'Software engineering and IT support from Tegal, Indonesia.',
    desc: 'I work across web applications, mobile apps, systems troubleshooting, and technical support.',
    cta: 'About me',
  },
  {
    no: '02',
    label: 'SKILLS',
    href: '/skills/',
    title: 'Web, mobile, backend, and infrastructure tools.',
    desc: 'My public work includes Astro, React, Flutter, Go, PostgreSQL, Docker, Cloudflare, and related tools.',
    cta: 'View skills',
  },
  {
    no: '03',
    label: 'PROJECTS',
    href: '/projects/',
    title: `${projectCount} public projects across several domains.`,
    desc: 'The catalog covers agency sites, donation platforms, travel services, community organizations, and developer tooling.',
    cta: 'View projects',
  },
  {
    no: '04',
    label: 'CONTACT',
    href: '/contact/',
    title: 'Discuss a project, role, or support requirement.',
    desc: 'Send the scope, timeline, and contact details for freelance work, full-time roles, or consulting.',
    cta: 'Contact me',
  },
];
---
<BaseLayout
  title="Haikal Akhalul Azhar - Software Engineer in Tegal, Indonesia"
  description="Haikal Akhalul Azhar is a software engineer in Tegal, Indonesia building web and mobile apps with Astro, React, and Flutter, plus IT support and networking."
  pageType="ProfilePage"
  pageMainEntityId="https://bio.ekalliptus.com/#person"
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="hero">
    <canvas id="hero-field" class="hero-field" aria-hidden="true"></canvas>
    <div class="hero-field-mask" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="hero-eyebrow reveal">
        <span class="hero-status-dot" aria-hidden="true"></span>
        Software Engineer · Tegal, Indonesia
      </p>

      <h1 class="hero-heading reveal">
        Haikal Akhalul Azhar<br>
        <span class="accent">builds web and mobile software.</span>
      </h1>

      <p class="hero-sub reveal" aria-hidden="true">
        <span id="typing-text"></span>
        <span class="typing-cursor">_</span>
      </p>
      <p class="sr-only">Software Engineer, IT Support Specialist, and AI Enthusiast.</p>

      <p class="hero-desc reveal">
        I build web applications and cross-platform mobile apps, support Windows and Linux systems,
        and use AI-assisted workflows for research, coding, testing, and automation.
      </p>

      <div class="hero-cta reveal">
        <a href="/projects/" class="btn btn-primary">View work</a>
        <a href="/contact/" class="btn btn-outline">Hire me</a>
      </div>
    </div>

    <!-- stat strip -->
    <div class="container">
      <div class="hero-stats reveal">
        <div class="hero-stat">
          <span class="hero-stat-num">8+</span>
          <span class="hero-stat-label">Years of experience</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">{projectCount}</span>
          <span class="hero-stat-label">Public projects</span>
        </div>
      </div>
    </div>

    <span class="hero-scroll" aria-hidden="true">Scroll to explore</span>
  </section>

  <!-- ── FOUR PILLARS ─────────────────────────────────────── -->
  <section class="pillars">
    <div class="container">
      {pillars.map(p => (
        <a href={p.href} class="pillar reveal">
          <span class="pillar-no">{p.no}</span>
          <div class="pillar-main">
            <span class="pillar-label">{p.label}</span>
            <h2 class="pillar-title">{p.title}</h2>
            <p class="pillar-desc">{p.desc}</p>
            <span class="pillar-cta">{p.cta} <span class="pillar-arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
/* ── HERO ── */
.hero {
  position: relative;
  min-height: calc(100vh - 96px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 64px 0 96px;
  isolation: isolate;
}

/* 3D particle field - sits behind hero content */
.hero-field {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  display: block;
  opacity: 0;
  transition: opacity 1200ms var(--ease);
}
.hero-field.ready { opacity: 1; }

/* Radial mask keeps the headline crisp over the field */
.hero-field-mask {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(80% 70% at 38% 42%, rgba(17,17,17,0.92), rgba(17,17,17,0.55) 45%, transparent 75%),
    linear-gradient(180deg, rgba(17,17,17,0.4) 0%, transparent 30%, transparent 70%, var(--bg) 100%);
}

.hero-inner { position: relative; z-index: 1; }

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--text-sec);
  margin-bottom: 32px;
}
.hero-status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #46d17f;
  box-shadow: 0 0 0 4px rgba(70, 209, 127, 0.16);
}

.hero-heading {
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.03em;
  max-width: 960px;
  margin-bottom: 24px;
}
.hero-heading .accent {
  display: inline-block;
  color: var(--accent);
}

.hero-sub {
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  color: var(--accent);
  font-family: var(--font-mono);
  font-weight: 500;
  min-height: 2rem;
  margin-bottom: 24px;
  letter-spacing: 0.01em;
}
.typing-cursor { animation: blink 1.1s steps(1) infinite; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

.hero-desc {
  font-size: clamp(1rem, 1.5vw, 1.1875rem);
  color: var(--text-sec);
  line-height: 1.7;
  max-width: 58ch;
  margin-bottom: 40px;
}

.hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }

/* stat strip */
.hero-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-top: 80px;
  padding-top: 40px;
  border-top: 1px solid var(--line-soft);
}
.hero-stat { display: flex; flex-direction: column; gap: 8px; }
.hero-stat-num {
  font-size: clamp(2rem, 4vw, 3.125rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
}
.hero-stat-label {
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  color: var(--text-mut);
}

.hero-scroll {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--font-mono);
  font-size: 0.625rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--text-faint);
  animation: scrollnudge 2.4s var(--ease) infinite;
}
@keyframes scrollnudge {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.5; }
  50% { transform: translateX(-50%) translateY(6px); opacity: 1; }
}

/* ── PILLARS ── */
.pillars {
  padding: 40px 0 80px;
  content-visibility: auto;
  contain-intrinsic-size: auto 1400px;
}

.pillar {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 40px;
  padding: 56px 0;
  border-top: 1px solid var(--line-soft);
  text-decoration: none;
  transition: padding-left var(--transition);
}
.pillar:last-child { border-bottom: 1px solid var(--line-soft); }
.pillar:hover { padding-left: 16px; }

.pillar-no {
  font-family: var(--font-mono);
  font-size: 1rem;
  font-weight: 500;
  color: var(--text-faint);
  padding-top: 6px;
  transition: color var(--transition);
}
.pillar:hover .pillar-no { color: var(--accent); }

.pillar-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.22em;
  color: var(--text-mut);
  margin-bottom: 18px;
}
.pillar-title {
  font-size: clamp(1.5rem, 3.4vw, 2.5rem);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.025em;
  color: var(--text);
  max-width: 22ch;
  margin-bottom: 18px;
  transition: color var(--transition);
}
.pillar:hover .pillar-title { color: var(--accent); }
.pillar-desc {
  font-size: 0.9375rem;
  color: var(--text-sec);
  line-height: 1.7;
  max-width: 56ch;
  margin-bottom: 22px;
}
.pillar-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text);
}
.pillar-arrow { transition: transform var(--transition); }
.pillar:hover .pillar-arrow { transform: translateX(6px); }

@media (max-width: 768px) {
  .hero { min-height: auto; padding: 32px 0 64px; }
  .hero-stats { grid-template-columns: 1fr 1fr; gap: 28px 20px; margin-top: 56px; }
  .hero-scroll { display: none; }
  .pillar { grid-template-columns: 1fr; gap: 12px; padding: 40px 0; }
  .pillar:hover { padding-left: 0; }
  .pillar-no { padding-top: 0; }
}
</style>

<script>
  let typingTimeout: ReturnType<typeof setTimeout> | null = null;

  document.addEventListener('astro:before-swap', () => {
    if (typingTimeout !== null) clearTimeout(typingTimeout);
    typingTimeout = null;
  });

  function initTyping() {
    const el = document.getElementById('typing-text');
    if (!el) return;

    const texts = ['Software Engineer', 'IT Support Specialist', 'AI Enthusiast'];
    let ti = 0, ci = 0, del = false;

    function tick() {
      if (!el) return;
      const cur = texts[ti];
      el.textContent = del ? cur.slice(0, ci - 1) : cur.slice(0, ci + 1);
      del ? ci-- : ci++;
      let spd = del ? 60 : 130;
      if (!del && ci === cur.length) { spd = 1800; del = true; }
      else if (del && ci === 0) { del = false; ti = (ti + 1) % texts.length; }
      typingTimeout = setTimeout(tick, spd);
    }

    tick();
  }

  document.addEventListener('astro:page-load', initTyping);

  // ── 3D hero field ──
  // Three.js (~469 KB) is heavy, so we DEFER it off the critical path:
  // the hero text paints first, then the field loads when the browser is idle.
  let heroField: { dispose: () => void } | null = null;
  let fieldLoading = false;
  let fieldGeneration = 0;
  let idleHandle: number | null = null;
  let timeoutHandle: number | null = null;

  async function loadField(canvas: HTMLCanvasElement, generation: number) {
    if (heroField || fieldLoading || !canvas.isConnected) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        (navigator as any).connection?.saveData) return;

    fieldLoading = true;
    try {
      const { initHeroField } = await import('../scripts/hero-field.js');
      if (generation !== fieldGeneration || !canvas.isConnected) return;
      heroField = initHeroField(canvas);
      if (heroField) requestAnimationFrame(() => canvas.classList.add('ready'));
    } catch {
      // CSS background remains as the no-WebGL fallback.
    } finally {
      fieldLoading = false;
    }
  }

  function scheduleField() {
    const canvas = document.getElementById('hero-field') as HTMLCanvasElement | null;
    if (!canvas) return;
    const generation = ++fieldGeneration;
    const ric = (window as any).requestIdleCallback as
      | ((cb: () => void, opts?: { timeout: number }) => number)
      | undefined;
    if (ric) idleHandle = ric(() => loadField(canvas, generation), { timeout: 2000 });
    else timeoutHandle = window.setTimeout(() => loadField(canvas, generation), 600);
  }

  function disposeField() {
    fieldGeneration++;
    if (idleHandle !== null && (window as any).cancelIdleCallback) {
      (window as any).cancelIdleCallback(idleHandle);
    }
    if (timeoutHandle !== null) clearTimeout(timeoutHandle);
    idleHandle = null;
    timeoutHandle = null;
    if (heroField) { heroField.dispose(); heroField = null; }
  }

  document.addEventListener('astro:page-load', scheduleField);
  document.addEventListener('astro:before-swap', disposeField);
</script>
