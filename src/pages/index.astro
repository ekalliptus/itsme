---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects.js';
const featured = [PROJECTS[0], PROJECTS[3], PROJECTS[2]];
---
<BaseLayout
  title="Haikal Akhalul Azhar - Software Engineer in Tegal, Indonesia"
  description="Haikal Akhalul Azhar is a software engineer in Tegal, Indonesia building web and mobile apps with Astro, React, and Flutter, plus IT support and networking."
  pageType="ProfilePage"
  pageMainEntityId="https://bio.ekalliptus.com/#person"
>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="hero-eyebrow"><span aria-hidden="true"></span> Haikal Akhalul Azhar · Software engineer</p>
      <h1 id="hero-heading"><span class="sr-only">Haikal Akhalul Azhar — </span>From interface<br>to <em>infrastructure.</em></h1>
      <p class="hero-desc">Hey, I'm Haikal. I build web and mobile apps, untangle IT problems, and connect the pieces that make things work.</p>
      <div class="hero-actions">
        <a href="/projects/" class="btn btn-primary">Explore my work <svg class="link-arrow" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13.5M13.5 8L9 3.5M13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href="/about/" class="about-link">A little about me <svg class="link-arrow" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13.5M13.5 8L9 3.5M13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
      <div class="hero-location"><span class="location-symbol" aria-hidden="true">⊕</span><span>Based in Tegal, Indonesia<br><span class="location-note">Building for the web. And beyond.</span></span></div>
    </div>
    <div class="hero-visual" id="hero-workbench">
      <div class="visual-top"><span class="visual-title">A look under the surface</span></div>
      <div class="scene-stage">
        <div class="scene-fallback" aria-hidden="true"><span></span><span></span><span></span><i></i></div>
        <canvas id="hero-field" aria-hidden="true"></canvas>
      </div>
      <div class="scene-label label-interface" aria-hidden="true"><span></span>Interface</div>
      <div class="scene-label label-logic" aria-hidden="true"><span></span>Logic</div>
      <div class="scene-label label-system" aria-hidden="true"><span></span>Infrastructure</div>
      <div class="visual-bottom">
        <p>Different layers.<br><strong>One connected system.</strong></p>
        <div class="scene-controls">
          <button id="scene-assemble" aria-pressed="false" disabled>Assemble <span aria-hidden="true">↙</span></button>
          <button id="scene-motion" aria-label="Pause 3D animation" aria-pressed="false" disabled><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2v10M10 2v10" stroke="currentColor" stroke-width="2"/></svg></button>
        </div>
      </div>
    </div>
    <div class="hero-footnote"><span>Web development <b aria-hidden="true">/</b> Mobile apps <b aria-hidden="true">/</b> IT support</span><a href="#selected-work">Scroll to explore <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="selected-work container" id="selected-work" aria-labelledby="work-heading">
    <div class="section-heading reveal">
      <div><p class="section-label">Out of the editor. Into the world.</p><h2 id="work-heading">A few things<br>I've <em>put together.</em></h2></div>
      <a href="/projects/" class="text-link">All {PROJECTS.length} projects <svg class="link-arrow" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13.5M13.5 8L9 3.5M13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    <div class="work-grid">
      {featured.map((project, index) => (
        <article class:list={['work-item', 'reveal', { 'work-lead': index === 0 }]}>
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="work-image-link" aria-label={`Visit ${project.name} website (opens in a new tab)`}>
            <div class="work-image"><img src={project.previewImage} alt={`${project.name} website preview`} width="1280" height="800" loading="lazy" decoding="async" /></div>
            <span class="work-open" aria-hidden="true">↗</span>
          </a>
          <div class="work-meta"><span>{project.category}</span><span>{project.tags.slice(0, 2).join(' / ')}</span></div>
          <h3><a href={project.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} (opens in a new tab)`}>{project.name} <svg class="link-arrow external" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></h3>
          <p>{project.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section container" aria-labelledby="about-heading">
    <div class="about-panel reveal">
      <div class="portrait-block"><img src="/img/ekal.webp" alt="Haikal Akhalul Azhar" width="600" height="600" loading="lazy" decoding="async" /><span>Tegal, Indonesia</span></div>
      <div class="about-copy"><p class="section-label">The person behind the pixels</p><h2 id="about-heading">Curiosity is<br>part of the <em>stack.</em></h2><p>Software engineer. IT support specialist. AI enthusiast. I enjoy understanding how things work, from the first screen to the system underneath.</p><p>My work spans web applications, cross-platform mobile apps, Windows and Linux support, and AI-assisted research, coding, testing, and automation.</p><a href="/about/" class="text-link">Meet Haikal <svg class="link-arrow" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13.5M13.5 8L9 3.5M13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
    </div>
    <div class="practice-row reveal"><div><span class="section-label">Tools for the whole picture</span><p>Astro & React. Flutter. Go & PostgreSQL.<br>Docker & Cloudflare. The right tool for the job.</p></div><a href="/skills/" class="btn btn-outline">Explore my toolkit <svg class="link-arrow" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13.5M13.5 8L9 3.5M13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
  </section>
</BaseLayout>
<style>
  .hero { display: grid; grid-template-columns: 1.08fr 1fr; gap: 12px; padding-top: 50px; }
  .hero-copy { padding-block: 30px 22px; align-self: center; }
  .hero-eyebrow { display: flex; align-items: center; gap: 8px; color: var(--text-sec); font: .67rem/1.6 var(--font-mono); margin-bottom: 30px; }
  .hero-eyebrow > span { flex-shrink: 0; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
  h1 { font-size: clamp(2.9rem, 4.8vw, 4.55rem); font-weight: 520; line-height: 1.12; letter-spacing: -.06em; margin-bottom: 28px; }
  em { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; letter-spacing: -.045em; color: var(--accent); }
  .hero-desc { max-width: 43ch; color: var(--text-sec); font-size: 1.08rem; line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .about-link { display: inline-flex; align-items: center; gap: 12px; padding-block: 12px; font-size: .85rem; }
  .about-link:hover, .text-link:hover { color: var(--accent); }
  .hero-location { display: flex; align-items: center; gap: 12px; margin-top: 42px; font: .68rem/1.7 var(--font-mono); color: var(--text-sec); }
  .location-symbol { font-size: 1.7rem; color: var(--accent); }
  .location-note { color: var(--text-mut); }
  .hero-visual { position: relative; isolation: isolate; min-width: 0; height: 530px; border: 1px solid var(--line); border-radius: 28px; background: #192d34; overflow: hidden; }
  .visual-top, .visual-bottom { position: absolute; left: 28px; right: 28px; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .visual-top { top: 25px; }
  .visual-title { color: var(--text-sec); font: .65rem/1.5 var(--font-mono); }
  .visual-badge { border: 1px solid var(--line-strong); border-radius: 5px; padding: 4px 7px; color: var(--text-mut); font: .56rem/1.5 var(--font-mono); letter-spacing: .1em; }
  .scene-stage { position: absolute; inset: 32px 0 65px; }
  #hero-field { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 600ms; }
  #hero-field.ready { opacity: 1; }
  .scene-fallback { position: absolute; inset: 15% 18%; transform: rotate(-18deg); transition: opacity 300ms; }
  .scene-fallback span { position: absolute; inset: 12% 0 38%; border: 15px solid #88d4c5; border-radius: 30%; transform: rotateX(55deg) rotateZ(-25deg); box-shadow: 0 10px 0 #42756f; }
  .scene-fallback span:nth-child(2) { top: 30%; bottom: 20%; border-color: var(--lilac); box-shadow: 0 10px 0 #6a628e; }
  .scene-fallback span:nth-child(3) { top: 50%; bottom: 0; border-color: #789aa8; box-shadow: 0 10px 0 #3d626e; }
  .scene-fallback i { position: absolute; left: 39%; top: 39%; width: 22%; aspect-ratio: 1; border-radius: 50%; background: var(--accent); }
  .hero-visual:has(.ready) .scene-fallback { opacity: 0; }
  .scene-label { position: absolute; z-index: 1; display: flex; align-items: center; gap: 6px; font: .58rem/1.5 var(--font-mono); color: var(--text-sec); pointer-events: none; transition: opacity 300ms; }
  .scene-label > span { width: 18px; height: 1px; background: var(--line-strong); }
  .label-interface { right: 22px; top: 28%; }
  .label-logic { left: 22px; top: 48%; }
  .label-system { right: 22px; top: 67%; }
  .hero-visual.assembled .scene-label { opacity: 0; }
  .visual-bottom { bottom: 24px; }
  .visual-bottom p { font-size: .75rem; color: var(--text-mut); line-height: 1.7; }
  .visual-bottom strong { color: var(--text-sec); font-weight: 400; }
  .scene-controls { display: flex; gap: 8px; }
  .scene-controls button { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 44px; padding: 10px 13px; border: 1px solid var(--line-strong); border-radius: 9px; font-size: .7rem; }
  .scene-controls button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .scene-controls button:disabled { opacity: .35; }
  .hero-footnote { grid-column: 1/-1; display: flex; justify-content: space-between; gap: 12px; padding: 22px 0 34px; border-bottom: 1px solid var(--line); color: var(--text-mut); font: .65rem/1.6 var(--font-mono); }
  .hero-footnote b { margin-inline: 18px; font-weight: 400; color: var(--line-strong); }
  .hero-footnote a { display: flex; gap: 12px; }
  .selected-work { padding-top: 96px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 40px; }
  .section-heading h2, .about-copy h2 { font-size: clamp(2.25rem, 4vw, 3.5rem); font-weight: 500; line-height: 1.13; letter-spacing: -.045em; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; padding-block: 10px; border-bottom: 1px solid var(--line-strong); font-size: .9rem; }
  .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 32px; }
  .work-lead { grid-column: 1/-1; }
  .work-image-link { position: relative; display: block; overflow: hidden; border-radius: 20px; background: #c1d1cc; }
  .work-image { padding: 32px 32px 0; aspect-ratio: 1.55; overflow: hidden; }
  .work-lead .work-image { aspect-ratio: 2.75; padding: 45px 10% 0; }
  .work-item:nth-child(2) .work-image-link { background: #c1bddd; }
  .work-item:nth-child(3) .work-image-link { background: #a3c6d3; }
  .work-image img { width: 100%; height: auto; border-radius: 9px 9px 0 0; box-shadow: 0 10px 35px #101b2033; transition: transform 700ms var(--ease); }
  .work-image-link:hover img { transform: translateY(-7px); }
  .work-open { position: absolute; top: 18px; right: 18px; width: 40px; height: 40px; display: grid; place-items: center; background: var(--bg); color: var(--text); border-radius: 50%; font-size: 1.25rem; }
  .work-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-top: 22px; color: var(--text-mut); font: .65rem/1.5 var(--font-mono); }
  .work-meta span:first-child { text-transform: capitalize; }
  .work-item h3 { font-size: 1.45rem; font-weight: 550; letter-spacing: -.035em; margin-block: 10px; }
  .work-item h3 a { display: flex; justify-content: space-between; }
  .work-item h3 span { color: var(--accent); font-family: var(--font-body); }
  .work-item > p { max-width: 75ch; font-size: .93rem; color: var(--text-sec); }
  .about-section { padding-top: 108px; }
  .about-panel { display: grid; grid-template-columns: .8fr 1.2fr; gap: 65px; padding: 44px; background: var(--bg-soft); border-radius: 28px; align-items: center; }
  .portrait-block { position: relative; overflow: hidden; background: #a7bfb9; border-radius: 16px; }
  .portrait-block img { width: 100%; height: 420px; object-fit: cover; object-position: center; filter: saturate(.65); }
  .portrait-block > span { position: absolute; bottom: 18px; left: 18px; color: var(--bg); background: var(--text); padding: 6px 10px; border-radius: 6px; font: .65rem/1.5 var(--font-mono); }
  .about-copy h2 { margin-bottom: 24px; }
  .about-copy > p:not(.section-label) { font-size: 1rem; color: var(--text-sec); margin-bottom: 16px; }
  .about-copy .text-link { margin-top: 8px; }
  .practice-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 42px 0 12px; }
  .practice-row .section-label { margin-bottom: 12px; }
  .practice-row p { font-size: 1rem; color: var(--text-sec); }
  @media (min-width: 1450px) { .hero-visual { height: 580px; } }
  @media (max-width: 1050px) { .hero { gap: 12px; } h1 { font-size: clamp(2.7rem, 4.8vw, 4rem); } .hero-visual { height: 500px; } .hero-eyebrow { font-size: .6rem; } .scene-label { display: none; } .visual-top, .visual-bottom { left: 18px; right: 18px; } .visual-bottom { align-items: end; } .visual-bottom p { font-size: .65rem; } .about-panel { gap: 32px; padding: 32px; } }
  @media (max-width: 760px) { .hero { grid-template-columns: 1fr; padding-top: 16px; gap: 28px; } .hero-copy { padding-block: 24px 0; } h1 { font-size: clamp(2.9rem, 8vw, 4.5rem); } .hero-eyebrow { font-size: .63rem; margin-bottom: 24px; } .hero-desc { max-width: 48ch; font-size: 1rem; } .hero-location { margin-top: 26px; } .hero-visual { height: 450px; } .visual-bottom p { font-size: .75rem; } .scene-label { display: flex; } .hero-footnote { padding-block: 0 24px; } .hero-footnote > a { display: none; } .hero-footnote b { margin-inline: 10px; } .selected-work, .about-section { padding-top: 64px; } .section-heading { align-items: start; flex-direction: column; gap: 18px; } .work-grid { gap: 36px; grid-template-columns: 1fr; } .work-lead { grid-column: auto; } .work-image, .work-lead .work-image { aspect-ratio: 1.55; padding: 24px 24px 0; } .about-panel { grid-template-columns: 1fr; padding: 24px; gap: 12px; } .portrait-block img { height: 340px; } .practice-row { align-items: start; flex-direction: column; } }
  @media (max-width: 390px) { h1 { font-size: 2.65rem; } .hero-actions { gap: 12px; } .hero-visual { height: 405px; } .visual-title { font-size: .58rem; } .visual-bottom p { font-size: .65rem; } .hero-footnote { font-size: .59rem; } }
</style>
<script>
  let dispose: (() => void) | undefined;
  let generation = 0;
  let idle: number | undefined;
  let timeout: number | undefined;
  function scheduleScene() {
    const canvas = document.getElementById('hero-field') as HTMLCanvasElement | null;
    if (!canvas) return;
    const current = ++generation;
    const connection = (navigator as Navigator & { connection?: { saveData: boolean } }).connection;
    if (connection?.saveData) return;
    const load = async () => {
      try {
        const { initHeroField } = await import('../scripts/hero-field.js');
        if (current !== generation || !canvas.isConnected) return;
        const scene = initHeroField(canvas);
        if (!scene) return;
        canvas.classList.add('ready');
        const assemble = document.getElementById('scene-assemble') as HTMLButtonElement;
        const motion = document.getElementById('scene-motion') as HTMLButtonElement;
        const workbench = document.getElementById('hero-workbench');
        const controller = new AbortController();
        const { signal } = controller;
        assemble.disabled = false;
        motion.disabled = false;
        let assembled = false;
        assemble.addEventListener('click', () => {
          assembled = !assembled;
          scene.setAssembled(assembled);
          workbench?.classList.toggle('assembled', assembled);
          assemble.setAttribute('aria-pressed', String(assembled));
          assemble.innerHTML = assembled ? 'Explode <svg class="link-arrow external" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' : 'Assemble <svg class="link-arrow external" style="transform:rotate(180deg)" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        }, { signal });
        const updateMotion = () => {
          motion.setAttribute('aria-pressed', String(scene.paused));
          motion.setAttribute('aria-label', scene.paused ? 'Play 3D animation' : 'Pause 3D animation');
          motion.innerHTML = scene.paused ? '<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2l8 5-8 5z" fill="currentColor"/></svg>' : '<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2v10M10 2v10" stroke="currentColor" stroke-width="2"/></svg>';
        };
        motion.addEventListener('click', () => { scene.setPaused(!scene.paused); updateMotion(); }, { signal });
        window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', updateMotion, { signal });
        updateMotion();
        dispose = () => { controller.abort(); scene.dispose(); };
      } catch {
        // ponytail: a CSS assembly covers unavailable WebGL; no second rendering engine.
      }
    };
    if ('requestIdleCallback' in window) idle = window.requestIdleCallback(load, { timeout: 1200 });
    else timeout = window.setTimeout(load, 100);
  }
  document.addEventListener('astro:page-load', scheduleScene);
  document.addEventListener('astro:before-swap', () => {
    generation++;
    if (idle !== undefined) window.cancelIdleCallback(idle);
    if (timeout !== undefined) window.clearTimeout(timeout);
    dispose?.();
    dispose = undefined;
  });
</script>
