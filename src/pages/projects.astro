---
// src/pages/projects.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS, PROJECT_CATEGORIES } from '../data/projects.js';

const projectListNode = {
  '@type': 'ItemList',
  '@id': 'https://bio.ekalliptus.com/projects/#project-list',
  name: 'Selected portfolio projects',
  itemListElement: PROJECTS.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      name: project.name,
      description: project.description,
      url: project.liveUrl,
    },
  })),
};
---
<BaseLayout
  title="Software Projects - Haikal Akhalul Azhar"
  description={`${PROJECTS.length} public web and software projects by Haikal Akhalul Azhar across agency, donation, travel, and developer tooling.`}
  pageType="CollectionPage"
  pageMainEntityId="https://bio.ekalliptus.com/projects/#project-list"
  pageNodes={[projectListNode]}
>
  <div class="container section">
    <header class="projects-intro">
      <div>
        <p class="section-label reveal">Selected projects</p>
        <h1 class="section-title reveal">Work, out<br><span class="accent">in the world.</span></h1>
      </div>
      <div class="projects-note reveal">
        <p class="section-desc">
          {PROJECTS.length} public projects across digital agencies, donation platforms,
          travel services, community organizations, and developer tooling.
        </p>
        <p class="projects-caption">Real websites. Open one to explore.</p>
      </div>
    </header>

    <div class="filter-bar reveal">
      <span class="filter-label">Browse by</span>
      <div class="filter-tabs" role="group" aria-label="Filter projects by category">
      {PROJECT_CATEGORIES.map(cat => (
        <button
          type="button"
          class:list={['filter-btn', { active: cat.id === 'all' }]}
          data-filter={cat.id}
          aria-pressed={cat.id === 'all' ? 'true' : 'false'}
          aria-controls="projects-grid"
        >
          {cat.label}
          <span class="filter-count" data-count={cat.id}>
            {cat.id === 'all' ? PROJECTS.length : PROJECTS.filter(p => p.category === cat.id).length}
          </span>
        </button>
      ))}
      </div>
    </div>

    <div class="projects-grid" id="projects-grid">
      {PROJECTS.map(project => (
        <div class="project-wrap" data-category={project.category}>
          <ProjectCard
            icon={project.icon}
            name={project.name}
            description={project.description}
            tags={project.tags}
            liveUrl={project.liveUrl}
            previewImage={project.previewImage}
          />
        </div>
      ))}
    </div>

    <p class="no-results" id="no-results" style="display:none">
      No projects in this category yet.
    </p>
  </div>
</BaseLayout>

<style>
.projects-intro {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: clamp(32px, 6vw, 88px);
  align-items: end;
  margin-bottom: 56px;
}

.projects-intro .section-title { margin-bottom: 0; }
.projects-note { padding-bottom: 8px; }
.projects-note .section-desc { margin-bottom: 24px; font-size: 0.9375rem; }
.projects-caption { font-family: Georgia, serif; font-style: italic; color: var(--accent-secondary, #b3abe7); font-size: 1.125rem; }

.filter-bar {
  display: flex;
  align-items: center;
  gap: 28px;
  padding: 18px 24px;
  margin-bottom: 32px;
  border-radius: 20px;
  background: var(--bg-soft);
}

.filter-label { color: var(--text-sec); font: 0.6875rem var(--font-mono); white-space: nowrap; }
.filter-tabs { display: flex; flex-wrap: wrap; gap: 8px; }

.filter-btn {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  min-height: 44px;
  padding: 10px 16px;
  border-radius: 10px;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-sec);
  transition: background var(--transition-fast), color var(--transition-fast);
}

.filter-btn:hover { background: var(--bg-card); color: var(--text); }
.filter-btn.active { background: var(--accent); color: var(--bg); }
.filter-count { font: 0.625rem var(--font-mono); }

.projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
.project-wrap { min-width: 0; transition: opacity 220ms var(--ease), transform 220ms var(--ease); }
.project-wrap.leaving { opacity: 0; transform: translateY(8px); pointer-events: none; }
.project-wrap.hidden { display: none; }
.no-results { text-align: center; color: var(--text-sec); font-size: 0.875rem; padding: 40px 0; }

@media (max-width: 760px) {
  .projects-intro { grid-template-columns: 1fr; gap: 24px; margin-bottom: 32px; }
  .projects-note .section-desc { margin-bottom: 16px; }
  .filter-bar { align-items: start; flex-direction: column; gap: 12px; padding: 20px; }
  .filter-btn { padding-inline: 12px; gap: 10px; }
  .projects-grid { grid-template-columns: 1fr; gap: 24px; }
}

@media (prefers-reduced-motion: reduce) {
  .project-wrap, .filter-btn { transition: none; }
  .project-wrap.leaving { opacity: 1; transform: none; }
}
</style>

<script>
  const EXIT_MS = 220;

  function initFilter() {
    const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-wrap');
    const noResults = document.getElementById('no-results');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let token = 0;

    function apply(filter: string) {
      const run = ++token;
      let visible = 0;
      const leaving: HTMLElement[] = [];

      cards.forEach(card => {
        const show = filter === 'all' || card.dataset.category === filter;
        if (show) {
          visible++;
          card.classList.remove('hidden', 'leaving');
        } else if (!card.classList.contains('hidden')) {
          card.classList.add('leaving');
          leaving.push(card);
        }
      });

      const hide = () => {
        if (run !== token) return;   // a newer filter click already took over
        leaving.forEach(card => card.classList.add('hidden'));
      };

      if (reduceMotion) hide();
      else setTimeout(hide, EXIT_MS);

      if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        apply(btn.dataset.filter ?? 'all');
      });
    });
  }

  document.addEventListener('astro:page-load', initFilter);
</script>
