---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found - Haikal Akhalul Azhar"
  description="The requested page could not be found."
  noindex
>
  <div class="container section error-section">
    <p class="section-label reveal">404</p>
    <h1 class="section-title reveal">Page not <span class="accent">found.</span></h1>
    <p class="section-desc reveal">
      The requested URL does not match a page on this site.
    </p>

    <div class="error-actions reveal">
      <a href="/" class="btn btn-primary">Go home →</a>
      <a href="/projects/" class="btn btn-outline">View projects</a>
    </div>
  </div>
</BaseLayout>

<style>
.error-section {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.error-actions {
  display: flex;
  gap: 16px;
  margin-top: 32px;
  flex-wrap: wrap;
}
</style>
