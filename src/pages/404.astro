---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 - Page Not Found | Haikal Akhalul Azhar"
  description="The page you were looking for could not be found."
>
  <div class="container section error-section">
    <p class="section-label reveal">404 Error</p>
    <h1 class="section-title reveal">Page not <span class="accent">found.</span></h1>
    <p class="section-desc reveal">
      The link you followed might be broken, or the page may have been moved or removed.
    </p>

    <div class="error-actions reveal">
      <a href="/" class="btn btn-primary">Return Home →</a>
      <a href="/projects/" class="btn btn-outline">Explore Projects</a>
    </div>
  </div>
</BaseLayout>

<style>
.error-section {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.error-actions {
  display: flex;
  gap: 16px;
  margin-top: 32px;
  flex-wrap: wrap;
}
</style>
