---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found - Haikal Akhalul Azhar"
  description="The requested page could not be found."
  noindex
>
  <div class="container section error-section">
    <p class="section-label reveal">404</p>
    <h1 class="reveal">Page not <br><em>found.</em></h1>
    <p class="section-desc reveal">The requested URL does not match a page on this site.</p>
    <div class="error-actions reveal">
      <a href="/" class="btn btn-primary">Go home <svg class="link-arrow" width="1.1em" height="1.1em" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13.5M13.5 8L9 3.5M13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <a href="/projects/" class="btn btn-outline">View projects</a>
    </div>
  </div>
</BaseLayout>
<style>
  .error-section { min-height: 65vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  h1 { font-size: clamp(3.2rem, 6vw, 5.5rem); font-weight: 550; line-height: 1.05; letter-spacing: -.065em; margin-bottom: 24px; }
  h1 em { font-family: Georgia, serif; font-weight: 400; color: var(--accent); letter-spacing: -.04em; }
  .error-actions { display: flex; gap: 20px; margin-top: 40px; flex-wrap: wrap; }
</style>
