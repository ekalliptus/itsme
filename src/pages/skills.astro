---
// src/pages/skills.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillsSphere from '../components/SkillsSphere.astro';

const categories = [
  'Mobile', 'Frontend', 'Backend', 'Database', 'Languages', 'CSS / UI', 'Tools',
];
---
<BaseLayout
  title="Technical Skills - Haikal Akhalul Azhar"
  description="Web, mobile, backend, database, infrastructure, and IT support skills represented in Haikal Akhalul Azhar's public work."
  pageType="WebPage"
>
  <div class="container section">
    <p class="section-label reveal">Technical Skills</p>
    <h1 class="section-title reveal">Tools represented in <br><span class="accent">public work.</span></h1>
    <p class="section-desc reveal">
      Explore the interactive visualization or browse the text list below. The categories cover
      mobile, frontend, backend, databases, interface tooling, infrastructure, and IT support.
    </p>

    <SkillsSphere />

    <div class="legend reveal">
      {categories.map(cat => (
        <span class="legend-item">
          <span class="legend-dot"></span>
          {cat}
        </span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  justify-content: center;
  margin-top: 24px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-sec);
  font-family: var(--font-mono);
  letter-spacing: 1px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
  /* Optical alignment: centering on the full line box makes a small dot sit
     too high relative to the lowercase glyphs. Nudge it down to the text's
     optical centre (its x-height), not the line-box centre. */
  transform: translateY(1px);
}
</style>
