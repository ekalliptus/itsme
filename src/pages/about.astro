---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import LazyImage from '../components/LazyImage.astro';
import { PROJECTS } from '../data/projects.js';

const projectCount = PROJECTS.length;

const expertise = [
  {
    icon: '📱',
    title: 'Mobile Development',
    desc: 'Cross-platform Flutter and Dart applications with structured state management and reusable interface components.',
  },
  {
    icon: '🌐',
    title: 'Web Development',
    desc: 'Websites and web applications built with Astro, React, Next.js, Vue, TypeScript, and Tailwind CSS.',
  },
  {
    icon: '⚙️',
    title: 'Backend & Automation',
    desc: 'APIs and services using Node.js, Laravel, Go, MySQL, and PostgreSQL, plus Python and shell automation for repetitive tasks.',
  },
  {
    icon: '🛠️',
    title: 'IT Support',
    desc: 'Hardware, software, and network troubleshooting across Windows and Linux, including installation, configuration, and system diagnostics.',
  },
];
---
<BaseLayout
  title="About Haikal Akhalul Azhar - Software Engineer"
  description="Background, technical focus, and public work of Haikal Akhalul Azhar, a software engineer and IT support specialist in Tegal."
  pageType="AboutPage"
  pageMainEntityId="https://bio.ekalliptus.com/#person"
>
  <div class="container section">
    <p class="section-label reveal">Profile</p>
    <h1 class="section-title reveal">Software engineering <br><span class="accent">and IT support.</span></h1>

    <div class="about-grid">
      <!-- Profile card -->
      <div class="profile-card card reveal">
        <div class="profile-img-wrap">
          <LazyImage
            src="/img/ekal.webp"
            alt="Portrait of Haikal Akhalul Azhar"
            width={280}
            height={280}
            loading="eager"
            fetchpriority="high"
            radius="50%"
          />
        </div>
        <div class="profile-info">
          <h2 class="profile-name">Haikal Akhalul Azhar</h2>
          <p class="profile-title">Software Engineer · IT Support Specialist · AI Enthusiast</p>
          <span class="status-badge">
            <span class="status-dot" aria-hidden="true"></span>
            Available for Hire
          </span>
        </div>
      </div>

      <!-- Bio + expertise -->
      <div class="about-content">
        <div class="card bio-card reveal">
          <p class="bio-text">
            I build mobile applications with Flutter and web products with Astro, React, Next.js, TypeScript, and supporting backend services.
          </p>
          <p class="bio-text">
            My <strong>{projectCount} public projects</strong> include agency websites, donation platforms, travel services, community organizations, and developer tools.
          </p>
          <p class="bio-text">
            I also troubleshoot Windows and Linux systems, hardware, software, and network issues. AI-assisted workflows support research, implementation, testing, and automation; technical decisions remain reviewed and verified.
          </p>

          <dl class="profile-facts">
            <div><dt>Primary role</dt><dd>Software Engineer</dd></div>
            <div><dt>Additional focus</dt><dd>IT Support and AI-assisted development</dd></div>
            <div><dt>Location</dt><dd>Tegal, Central Java, Indonesia</dd></div>
            <div><dt>Education</dt><dd>Associate Degree in Information Systems, Universitas Bina Sarana Informatika</dd></div>
          </dl>
        </div>

        <div class="expertise-grid">
          {expertise.map(item => (
            <div class="expertise-card card reveal">
              <span class="expertise-icon">{item.icon}</span>
              <h3 class="expertise-title">{item.title}</h3>
              <p class="expertise-desc">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="cv-card card reveal">
          <h3 class="cv-title">Resume</h3>
          <p class="cv-desc">Work history, education, technical skills, and selected project experience.</p>
          <div class="cv-actions">
            <a
              href="https://anrdart-my.sharepoint.com/:b:/g/personal/salam_ekalliptus_com/IQDTxgH0B1ZKQ6Jm77oC6n5wAVyIOSxSOfjG-QI258s2fjw?e=UMVXyM"
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View Haikal Akhalul Azhar's resume in English (opens in a new tab)"
            >
              Resume (English) <span aria-hidden="true">↗</span>
            </a>
            <a
              href="/cv/Haikal-Akhalul-Azhar-CV-ID.pdf"
              class="btn btn-outline"
              aria-label="Download Haikal Akhalul Azhar's resume in Indonesian (PDF)"
            >
              CV (Bahasa Indonesia)
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.profile-facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1px solid var(--line);
}

.cv-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.profile-facts div { min-width: 0; }
.profile-facts dt {
  color: var(--text-mut);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.08em;
  margin-bottom: 4px;
  text-transform: uppercase;
}
.profile-facts dd {
  color: var(--text);
  font-size: 0.875rem;
  line-height: 1.5;
  margin: 0;
}

.about-grid {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 32px;
  align-items: start;
}

.profile-card {
  position: sticky;
  top: 100px;
  text-align: center;
  padding: 28px;
}

.profile-img-wrap {
  width: 180px;
  height: 180px;
  margin: 0 auto 20px;
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid var(--accent-line);
}

.profile-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-name {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 4px;
}

.profile-title {
  font-size: 12px;
  color: var(--text-sec);
  margin-bottom: 14px;
  line-height: 1.5;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--text-sec);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--line);
  border-radius: var(--radius-pill);
  padding: 5px 13px;
}

.status-dot {
  width: 7px;
  height: 7px;
  background: #46d17f;
  box-shadow: 0 0 0 3px rgba(70, 209, 127, 0.18);
  border-radius: 50%;
  animation: pulse 2.4s var(--ease) infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.bio-card {
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.bio-text {
  font-size: 0.95rem;
  color: var(--text-sec);
  line-height: 1.75;
}

.bio-text strong {
  color: var(--text);
  font-weight: 600;
}

.expertise-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 20px;
}

.expertise-card {
  padding: 20px;
}

.expertise-icon {
  font-size: 1.8rem;
  margin-bottom: 10px;
  display: block;
}

.expertise-title {
  font-size: 0.9rem;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--violet-light);
}

.expertise-desc {
  font-size: 12px;
  color: var(--text-sec);
  line-height: 1.65;
}

.cv-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.cv-title {
  font-size: 1rem;
  font-weight: 700;
}

.cv-desc {
  font-size: 13px;
  color: var(--text-sec);
}

@media (max-width: 900px) {
  .about-grid {
    grid-template-columns: 1fr;
  }

  .profile-card {
    position: static;
  }

  .expertise-grid,
  .profile-facts {
    grid-template-columns: 1fr;
  }
}
</style>
